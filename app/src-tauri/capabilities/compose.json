{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "compose",
  "description": "Compose windows (a message being written in a window of its own)",
  "windows": [
    "compose-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:webview:allow-set-webview-zoom"
  ]
}

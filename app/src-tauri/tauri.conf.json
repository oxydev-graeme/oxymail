{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OxyMail",
  "version": "0.1.0",
  "identifier": "co.oxydev.oxymail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OxyMail",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; frame-src 'self' data: about:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Office",
    "shortDescription": "Email client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}

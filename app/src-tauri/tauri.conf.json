{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OxyMail",
  "version": "0.3.0",
  "identifier": "co.oxydev.oxymail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OxyMail",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; frame-src 'self' data: about:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Email, calendar and contacts",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Oxydev",
    "homepage": "https://github.com/oxydev-graeme/oxymail",
    "longDescription": "Email with room to breathe: an email client with calendar and contacts for Windows, macOS and Linux.",
    "license": "GPL-3.0-only",
    "linux": {
      "deb": {
        "desktopTemplate": "oxymail.desktop",
        "section": "mail"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "oxymail",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBRkQ1RjlFQ0Q3QzQ2MzkKUldRNVJuek5ubC85R2tWS2hadDYwNDBEdG9rbkRWUEJVRndpTjVoMEIyeFluQ3laNk0zVVljS3MK",
      "endpoints": [
        "https://github.com/oxydev-graeme/oxymail/releases/latest/download/latest.json"
      ]
    }
  }
}
